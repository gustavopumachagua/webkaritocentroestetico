# Entrega publica de imagenes. Vite expone estas variables al navegador.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_BASE_FOLDER=
VITE_CLOUDINARY_DELIVERY_TYPE=upload
VITE_CLOUDINARY_TRANSFORMATION=f_auto,q_auto
VITE_CLOUDINARY_VERSION=

# Subida local a Cloudinary. No uses prefijo VITE_ en credenciales privadas.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_UPLOAD_BYTES=10485760
CLOUDINARY_UPLOAD_TRANSFORMATION=c_limit,w_1920,h_1920,q_auto:eco,fl_strip_profile
CLOUDINARY_LOCAL_OPTIMIZE=true
CLOUDINARY_OPTIMIZE_MIN_BYTES=153600
CLOUDINARY_LOCAL_MAX_DIMENSION=1920
CLOUDINARY_LOCAL_JPEG_QUALITY=82
CLOUDINARY_LOCAL_WEBP_QUALITY=78
